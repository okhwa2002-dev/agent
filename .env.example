# 에이전트 환경변수 (이 파일을 .env로 복사해서 값 채우기)
# cp .env.example .env

# PostgreSQL 연결 (docker-compose 기준: 포트 5435, db agent_db)
DATABASE_URL=postgres://agent:agentpw@localhost:5435/agent_db

# MQTT 브로커 (브로커 인증 사용 — URL에 계정 포함. dev 기본 agent/agentmqttpw, 운영 배포 시 교체)
MQTT_URL=mqtt://agent:agentmqttpw@localhost:1883
MQTT_TOPIC=device/+/msg

# (선택) durable 세션용 클라이언트 ID (기본 edge-agent)
# MQTT_CLIENT_ID=edge-agent

# 로그 파일 디렉터리 (미설정 시 실행 cwd의 ./logs)
LOG_DIR=D:\workspace\ok2020\log\agent

# Redis 버퍼 (requirepass 사용 — URL에 비밀번호 포함. dev 기본, 운영 배포 시 교체)
REDIS_URL=redis://:agentredispw@localhost:6379

# 인프로세스 워커 수 (기본 4)
WORKER_CONCURRENCY=4

# 관측성 HTTP 포트: /health, /metrics (기본 9100, 0이면 비활성)
# METRICS_PORT=9100
# 바인드 주소 (기본 127.0.0.1=로컬 전용. 외부에서 지표를 수집하려면 0.0.0.0 + 방화벽 허용)
# METRICS_HOST=127.0.0.1

# (운영) compose 크리덴셜 주입 — 미설정 시 dev 기본값 사용. MQTT 비밀번호 변경 시 passwd 파일도 재생성 필요.
# POSTGRES_PASSWORD=...
# REDIS_PASSWORD=...
# MQTT_PASSWORD=...
