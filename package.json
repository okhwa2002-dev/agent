    "test:watch": "vitest",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "mqtt": "^5.10.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
