{
  "name": "edge-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('fs').mkdirSync('dist/db',{recursive:true});require('fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js",
    "reprocess": "node dist/reprocess.js",
    "dlq": "node dist/dlq.js",
    "device": "node dist/device.js",
    "pub": "node scripts/pub.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "mqtt": "^5.10.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.2",
    "@testcontainers/redis": "^12.0.2",
    "@types/node": "^20.16.5",
    "@types/pg": "^8.11.10",
    "testcontainers": "^12.0.4",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
